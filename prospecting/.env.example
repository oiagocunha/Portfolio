# Google Places API (New) — chave com Places API habilitada
GOOGLE_PLACES_API_KEY=

# Google Sheets — ID da planilha (parte da URL entre /d/ e /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Nome da aba (criada automaticamente se não existir)
# Recomendado após Fase 2: Leads_v2 (colunas novas)
GOOGLE_SHEETS_SHEET_NAME=Leads

# Caminho para o JSON da service account (ou cole o JSON inline em GOOGLE_SERVICE_ACCOUNT_JSON)
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# Alternativa: JSON da service account em uma linha (útil em CI)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Limites e resiliência
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3
REQUEST_DELAY_MS=200

# --- Fase 2: Website ---
WEBSITE_TIMEOUT_MS=12000
WEBSITE_CONCURRENCY=3
WEBSITE_MAX_HTML_BYTES=1500000

# --- Fase 2: IA (opcional; sem chave usa fallback determinístico) ---
AI_ENABLED=true
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_PER_RUN=40
